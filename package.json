{
  "name": "next-step-ai-backend2",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js backend for the Next-Step-AI Laravel API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch -r ts-node/register src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/app.test.cjs tests/services.test.cjs",
    "test:integration": "npm run build && node --test tests/mongodb.integration.test.cjs",
    "seed": "npm run build && node dist/seed.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "docx": "^9.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.7.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^3.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
